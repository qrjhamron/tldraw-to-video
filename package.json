{
  "name": "native-stroke-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/verify-browser.ts",
    "export": "tsx scripts/export.ts",
    "verify:media": "tsx scripts/verify-media.ts",
    "inspect:media": "tsx scripts/inspect-media.ts",
    "test:controls": "tsx scripts/verify-controls.ts",
    "lesson:compile": "tsx scripts/compile-flagship.ts",
    "tts": "tsx scripts/narration.ts",
    "export:flagship": "tsx scripts/export-flagship.ts",
    "test:v2:browser": "tsx scripts/verify-v2-browser.ts",
    "verify:flagship": "tsx scripts/verify-flagship-media.ts",
    "test:editing": "tsx scripts/verify-editing-browser.ts",
    "handwriting:compare": "tsx scripts/compare-handwriting.ts && tsx scripts/export-flagship.ts --recording output/handwriting-comparison.recording.json --output output/handwriting-comparison.mp4",
    "verify:handwriting": "tsx scripts/verify-handwriting.ts",
    "mcp": "tsx scripts/mcp-server.ts",
    "visual:poc": "tsx scripts/create-visual-poc.ts",
    "verify:visual": "tsx scripts/verify-visual-poc.ts",
    "tricks:compile": "tsx scripts/compile-tricks.ts",
    "tricks:narrate": "tsx scripts/narrate-tricks.ts",
    "tricks:export": "tsx scripts/export-tricks.ts",
    "tricks:combine": "tsx scripts/combine-tricks.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tldraw/assets": "5.5.2",
    "@tldraw/tlschema": "5.5.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tldraw": "5.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
